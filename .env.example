# apiz CLI 生图配置（全部可省略）
#
# 生图通道：
#   - Codex 环境 → 使用 agent 内置 imagegen 工具，不读取本文件
#   - 其他环境   → scripts/generate_image.py，内部调用 apiz CLI
#
# 认证由 apiz CLI 处理，优先级：--api-key > APIZ_API_KEY > 配置文件（apiz auth login）
# 本机已执行过 `apiz auth login` 时，以下都不需要配置。

# 图片模型 id（用 `apiz models list` 查看全部，category=image）
APIZ_IMAGE_MODEL=openai/gpt-image-2

# 仅当未使用 `apiz auth login` 时才需要设置 key
# APIZ_API_KEY=your-apiz-api-key

# CLI 后端地址（一般不用改）
# APIZ_BASE_URL=https://api.apiz.ai

# apiz 可执行文件路径（不在 PATH 时才需要）
# APIZ_BIN=C:\Users\you\.local\bin\apiz.exe

# ===== 旧变量别名（仍兼容，不建议新用）=====
# IMG_MODEL / OPENAI_IMAGE_MODEL / OPENAI_MODEL   → APIZ_IMAGE_MODEL
# IMG_API_KEY / OPENAI_API_KEY                    → APIZ_API_KEY
# IMG_BASE_URL / OPENAI_BASE_URL                  → APIZ_BASE_URL
